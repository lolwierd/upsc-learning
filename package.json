{
  "name": "upsc-mcq-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:dump": "node scripts/llm-dump-server.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @mcqs/db migrate",
    "db:generate": "pnpm --filter @mcqs/db generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "turbo": "^2.9.14",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "cookie@<0.7.0": "0.7.2",
      "esbuild@<=0.24.2": "0.25.12",
      "undici@<6.23.0": "6.23.0",
      "undici@>=7.0.0 <7.18.2": "7.18.2"
    }
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
